{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MobiMindS1Context",
  "type": "object",
  "required": ["context", "prediction", "verification"],
  "properties": {
    "context": {
      "type": "object",
      "required": ["app", "screen", "battery", "network", "event", "goal"],
      "properties": {
        "app": { "type": "string" },
        "screen": { "type": "string" },
        "battery": { "type": "integer", "minimum": 0, "maximum": 100 },
        "network": { "type": "string", "enum": ["wifi", "cellular", "none", "airplane"] },
        "event": { "type": "string" },
        "goal": { "type": "string" }
      }
    },
    "prediction": {
      "type": "object",
      "required": ["intent", "action", "risk", "confidence"],
      "properties": {
        "intent": { "type": "string" },
        "action": {
          "type": "string",
          "enum": [
            "OpenApp",
            "Tap",
            "Back",
            "Scroll",
            "ToggleSetting",
            "DoNothing"
          ]
        },
        "action_params": { "type": "object" },
        "risk": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 }
      }
    },
    "verification": {
      "type": "object",
      "required": ["required", "expected_state", "observed_state", "success"],
      "properties": {
        "required": { "type": "boolean" },
        "expected_state": { "type": "object" },
        "observed_state": { "type": "object" },
        "success": { "type": "boolean" }
      }
    }
  }
}
